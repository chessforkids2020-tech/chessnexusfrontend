# Production environment variables for Vercel deployment.
# These are the REAL production URLs (AWS, not Render). Because they live here in
# .env.production, `npm run build` automatically uses them — you do NOT need to set
# VITE_API_URL inline or in the Vercel dashboard every time. Set once, always correct.
VITE_API_URL=https://api.chessnexus.in
VITE_SOCKET_URL=https://api.chessnexus.in
VITE_3D_ARENA_URL=https://3darena.chessnexus.in