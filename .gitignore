# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# dist/ is committed on purpose: Vercel serves this prebuilt, prerendered
# output directly (see vercel.json) instead of building Chromium in CI.
# Rebuild with `npm run build` and commit dist/ before deploying.
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vercel
.vercel

# Playwright
/playwright-report
/test-results
/test-results/
/playwright/.cache

# Large puzzle source datasets (not used by the app at runtime — kept out of git)
public/puzzles/lichess_db_puzzle.csv
public/puzzles/racer/
public/test/
public/bingo_cleaned.csv
public/part1.csv

# Stray Windows reserved-name file
nul.css

# Raw PGN archives — source data for scripts/buildReplayGames.js.
# Multi-hundred-MB files must never be committed or shipped to the browser:
# anything under public/ is bundled into dist/ and served to every visitor.
public/replay-traning/
public/replay-games-raw/
*.pgn

# Environment files — never commit these.
# They hold only VITE_* URLs today (Vite inlines those into the public bundle
# anyway), but a tracked .env is where a real secret eventually gets added by
# accident. Keep them local; set the values in the Vercel dashboard, or pass
# VITE_API_URL inline when building.
.env
.env.*
!.env.example
